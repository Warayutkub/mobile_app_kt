<?xml version="1.0" encoding="utf-8"?>
<!-- 01 Splash (แบบ A) — แนวนอน: โลโก้ซ้าย ข้อความขวา -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".MainActivity">

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_ring"
        android:translationX="-120dp"
        android:translationY="-120dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_ring"
        android:translationX="80dp"
        android:translationY="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/splashTop"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/space_xl"
        app:layout_constraintBottom_toTopOf="@+id/splashFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:contentDescription="โลโก้ FITM ครบรอบ 30 ปี"
            android:scaleType="fitCenter"
            android:src="@drawable/fitm_logo_30" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:orientation="vertical">

            <TextView
                style="@style/Text.H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ภาควิชาเทคโนโลยีสารสนเทศ" />

            <TextView
                style="@style/Text.BodySm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="“พัฒนาคน เพื่อพัฒนาเทคโนโลยีสารสนเทศ”"
                android:textColor="@color/muted" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/splashFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_2xl"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintBottom_toBottomOf="parent">

        <include layout="@layout/view_loading_dots" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="คณะเทคโนโลยีและการจัดการอุตสาหกรรม · มหาวิทยาลัยเทคโนโลยีพระจอมเกล้าพระนครเหนือ วิทยาเขตปราจีนบุรี" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
