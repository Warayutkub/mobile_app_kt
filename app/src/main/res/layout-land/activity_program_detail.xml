<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ProgramDetailActivity">

    <include
        android:id="@+id/appBar"
        layout="@layout/view_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBar">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_2xl"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_base"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <include
                        layout="@layout/view_detail_hero"
                        android:layout_width="160dp"
                        android:layout_height="112dp" />

                    <include
                        layout="@layout/view_detail_heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1" />
                </LinearLayout>

                <include
                    layout="@layout/view_detail_facts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base" />

                <include
                    layout="@layout/view_detail_structure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <include
                    layout="@layout/view_detail_plans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_base"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_xl">

                <include layout="@layout/view_detail_links" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApply"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:layout_marginTop="@dimen/space_base"
                    android:text="สมัครเรียน" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
