<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD">
    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#111827"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="คุณวุฒิผู้สมัคร"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnContainer"
        android:layout_below="@id/headerLayout">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คุณจบการศึกษาระดับไหน?"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="เลือกวุฒิการศึกษา แล้วดูว่าสมัครหลักสูตรไหนได้"
                android:textColor="#6B7280"
                android:textSize="14sp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <RadioGroup
                            android:id="@+id/radioGroupQualification"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp">
                            <RadioButton
                                android:id="@+id/radioSciMath"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="ม.6 สายวิทย์-คณิต"
                                android:textColor="#111827"
                                android:textSize="16sp"/>
                            <RadioButton
                                android:id="@+id/radioOtherHighSchool"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="ม.6 สายอื่น"
                                android:textColor="#111827"
                                android:textSize="16sp"/>
                            <RadioButton
                                android:id="@+id/radioVocational"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="ปวช."
                                android:textColor="#111827"
                                android:textSize="16sp"/>
                            <RadioButton
                                android:id="@+id/radioHighVocationalBiz"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="ปวส. พานิชยกรรม / บริหารธุรกิจ"
                                android:textColor="#111827"
                                android:textSize="16sp"/>
                            <RadioButton
                                android:id="@+id/radioHighVocationalTech"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="12dp"
                                android:text="ปวส. ช่างอุตสาหกรรม"
                                android:textColor="#111827"
                                android:textSize="16sp"/>
                        </RadioGroup>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/layoutResultCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="#E8F5E9"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvResultCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="สมัครได้ 2 หลักสูตร"
                            android:textColor="#2E7D32"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/tvCourse1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawableStart="@android:drawable/checkbox_on_background"
                            android:drawablePadding="8dp"
                            android:text="วท.บ. เทคโนโลยีสารสนเทศ (4 ปี)"
                            android:textColor="#2E7D32"
                            android:textSize="14sp"
                            app:drawableTint="#2E7D32"/>
                        <TextView
                            android:id="@+id/tvCourse2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawableStart="@android:drawable/checkbox_on_background"
                            android:drawablePadding="8dp"
                            android:text="วศ.บ. วิศวกรรมสารสนเทศและเครือข่าย (4 ปี)"
                            android:textColor="#2E7D32"
                            android:textSize="14sp"
                            app:drawableTint="#2E7D32"/>
                        <TextView
                            android:id="@+id/tvCourse3"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:drawableStart="@android:drawable/checkbox_on_background"
                            android:drawablePadding="8dp"
                            android:text="อส.บ. เทคโนโลยีสารสนเทศ (ต่อเนื่อง)"
                            android:textColor="#2E7D32"
                            android:textSize="14sp"
                            app:drawableTint="#2E7D32"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="* เกณฑ์อ้างอิงจากเว็บไซต์คณะ\nโปรดตรวจสอบประกาศรับสมัครล่าสุดอีกครั้ง"
                        android:textColor="#9CA3AF"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- Bottom Action Button Container -->
    <LinearLayout
        android:id="@+id/btnContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:padding="16dp">
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#2563EB"
            android:text="ดูรอบการรับสมัคร"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</RelativeLayout>
