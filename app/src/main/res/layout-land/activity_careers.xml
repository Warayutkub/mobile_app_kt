<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">
    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomBarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <!-- 1. Top App Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#111B29"
                    tools:ignore="ContentDescription"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="จบแล้วทำอะไร"
                    android:textColor="#111B29"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <!-- 3. Top Banner Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#2956E4"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/bannerIcon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ทำงานได้ทั้งภาครัฐและเอกชน"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="หรือเป็นฟรีแลนซ์ / เปิดธุรกิจด้านไอทีของตัวเอง"
                            android:textColor="#D0D9FF"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/bannerIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_semi_transparent"
                        android:padding="12dp"
                        android:src="@drawable/ic_briefcase"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@android:color/white"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <!-- 4. Grid Section for 10 Careers -->
            <GridLayout
                android:id="@+id/gridCareers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="16dp"
                android:columnCount="5">
                <!-- Item 1: วิศวกรระบบเครือข่าย -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_node"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="วิศวกรระบบเครือข่าย"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 2: นักวิชาการคอมพิวเตอร์ -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_computer"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="นักวิชาการคอมพิวเตอร์"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 3: วิศวกรระบบคลาวด์ -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_cloud"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="วิศวกรระบบคลาวด์"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 4: วิศวกรความมั่นคงปลอดภัยทางไซเบอร์ -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_shield"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="วิศวกรความมั่นคงปลอดภัยทางไซเบอร์"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 5: วิศวกรระบบ -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_gear"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="วิศวกรระบบ"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 6: นักวิทยาการข้อมูล -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_server"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="นักวิทยาการข้อมูล"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 7: โปรแกรมเมอร์ / ผู้พัฒนาซอฟต์แวร์ -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_code1"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="โปรแกรมเมอร์ / ผู้พัฒนาซอฟต์แวร์"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 8: นักวิเคราะห์ข้อมูล -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle">
                    <LinearLayout style="@style/CareerCardContentStyle">
                        <ImageView
                            style="@style/CareerIconStyle"
                            android:src="@drawable/ic_user"/>
                        <TextView
                            style="@style/CareerTextStyle"
                            android:text="อาชีพอิสระ / อาชีพอื่น ๆ ที่เกี่ยวข้อง"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- Item 9: นักวิทยาศาสตร์ข้อมูล -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle" />
                <!-- Item 10: บุคลากรทางการศึกษา -->
                <androidx.cardview.widget.CardView style="@style/CareerCardStyle" />
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- 5. Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAllCourses"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ดูหลักสูตรทั้งหมด"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#2956E4"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
