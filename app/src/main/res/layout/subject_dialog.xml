<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:padding="24dp">

    <!-- ตัว Card Dialog กลางหน้าจอ -->
    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

            <!-- Header: รหัสวิชา และ ปุ่มปิด (X) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSubjectCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_rounded_light_blue"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="060243102"
                    android:textColor="#2563EB"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- ชื่อวิชาภาษาไทย และ ภาษาอังกฤษ -->
            <TextView
                android:id="@+id/tvSubjectTitleTh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="การโปรแกรมคอมพิวเตอร์"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubjectTitleEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Computer Programming"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <!-- แถบแสดงหน่วยกิต และ ชั่วโมงเรียน 4 ช่อง -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- หน่วยกิต -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_blue"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCredits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="หน่วยกิต"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- บรรยาย ชม. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_light_gray"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLectureHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="#2563EB"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="บรรยาย ชม."
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- ปฏิบัติ ชม. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_light_gray"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLabHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textColor="#2563EB"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ปฏิบัติ ชม."
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- ศึกษาเอง ชม. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_light_gray"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSelfHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="#2563EB"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ศึกษาเอง ชม."
                        android:textColor="#6B7280"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- วิชาบังคับก่อน -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Info"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#6B7280" />

                <TextView
                    android:id="@+id/tvPrerequisite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="วิชาบังคับก่อน: ไม่มี - เรียนปีที่ 1 ภาคเรียนที่ 1"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- คำอธิบายรายวิชา -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="เรียนพื้นฐานการเขียนโปรแกรมเชิงโครงสร้างตั้งแต่ชนิดข้อมูล ตัวแปร ตัวดำเนินการ การตัดสินใจ การวนรอบ ฟังก์ชัน อาร์เรย์ และการจัดการไฟล์ พร้อมฝึกเขียนโปรแกรมจริงในห้องปฏิบัติการ"
                android:textColor="#374151"
                android:textSize="13sp" />

            <!-- ปุ่มปิด -->
            <Button
                android:id="@+id/btnCloseButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F0F4FE"
                android:text="ปิด"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>