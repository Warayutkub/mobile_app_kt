<?xml version="1.0" encoding="utf-8"?>
<!-- เมนู 6 ปุ่ม "สำรวจภาควิชา" (3 x 2) — ไอคอน/ชื่อ/ปลายทางตั้งใน HomeActivity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include android:id="@+id/tileAbout" layout="@layout/item_quick_tile" />
        <include android:id="@+id/tileQualification" layout="@layout/item_quick_tile" />
        <include android:id="@+id/tileFees" layout="@layout/item_quick_tile" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include android:id="@+id/tileLearn" layout="@layout/item_quick_tile" />
        <include android:id="@+id/tileCareers" layout="@layout/item_quick_tile" />
        <include android:id="@+id/tileGallery" layout="@layout/item_quick_tile" />
    </LinearLayout>
</LinearLayout>
