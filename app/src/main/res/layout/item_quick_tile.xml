<?xml version="1.0" encoding="utf-8"?>
<!-- Tile/Quick: ไอคอน + ชื่อเมนู (หน้า Home) ตั้งไอคอน/ข้อความใน HomeActivity -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingVertical="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_round_14"
            android:backgroundTint="@color/primary_50">

            <ImageView
                android:id="@+id/tileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tileLabel"
            style="@style/Text.CaptionStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
